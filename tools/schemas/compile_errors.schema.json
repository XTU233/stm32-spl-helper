{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/stm32_spl_helper/compile_errors.schema.json",
  "title": "CompileErrorBundle",
  "description": "assets/data/compile_errors.json —— 编译/链接/下载错误速查条目。",
  "type": "object",
  "required": ["schemaVersion", "categories", "errors"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nameZh"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "examples": ["linker", "compiler", "download", "runtime"] },
          "nameZh": { "type": "string" },
          "nameEn": { "type": "string" },
          "orderIndex": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titleZh", "categoryId"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^err\\.[a-z0-9_]+$" },
          "titleZh": { "type": "string" },
          "categoryId": { "type": "string", "description": "必须存在于 categories" },
          "toolchain": { "type": "string", "examples": ["keil", "gcc-arm", "st-link", "generic"] },
          "messagePatterns": { "type": "array", "items": { "type": "string" }, "description": "搜索匹配用的错误原文片段" },
          "messageSample": { "type": "string", "description": "完整错误原文样例，可复制" },
          "explainZh": { "type": "string" },
          "causes": { "type": "array", "items": { "type": "string" } },
          "solutions": { "type": "array", "items": { "type": "string" }, "description": "有序解决步骤" },
          "codeSnippets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code"],
              "additionalProperties": true,
              "properties": {
                "language": { "type": "string" },
                "title": { "type": "string" },
                "code": { "type": "string" }
              }
            }
          },
          "relatedFunctionIds": { "type": "array", "items": { "type": "string" } },
          "relatedSymbolIds": { "type": "array", "items": { "type": "string" } },
          "relatedPeripheralIds": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "ai": { "type": ["object", "null"] }
        }
      }
    }
  }
}
