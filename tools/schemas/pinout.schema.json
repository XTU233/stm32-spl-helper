{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/stm32_spl_helper/pinout.schema.json",
  "title": "PinoutData",
  "description": "assets/data/pinout_<chip>.json —— LQFP48 引脚数据。verified 必须为 false 直到人工对照数据手册核对完成。",
  "type": "object",
  "required": ["schemaVersion", "chipId", "package", "verified", "pins"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "chipId": { "type": "string" },
    "package": { "type": "string", "examples": ["LQFP48"] },
    "source": { "type": "string", "description": "数据来源，如 DS5319 Table 5" },
    "verified": { "type": "boolean", "description": "是否已人工核对数据手册" },
    "verifiedNote": { "type": "string", "description": "未核对时的提示文字；verified 为 false 时必填" },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "name"],
        "additionalProperties": true,
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 100 },
          "name": { "type": "string", "description": "引脚名，如 PA9 / VBAT" },
          "groups": {
            "type": "array",
            "items": { "type": "string", "enum": ["power", "ground", "reset", "boot", "gpio", "osc", "debug", "vref", "other"] }
          },
          "defaultFunction": { "type": "string" },
          "defaultFunctionZh": { "type": "string" },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "kind"],
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string", "description": "如 USART1_TX / TIM1_CH2" },
                "kind": { "type": "string", "enum": ["af", "gpio", "power", "ground", "debug", "boot", "osc", "reset", "other"] },
                "remapRequired": { "type": "boolean", "description": "是否需要 GPIO_PinRemapConfig" },
                "peripheralId": { "type": "string", "description": "关联外设 id，用于跳转" },
                "remapNoteZh": { "type": "string" }
              }
            }
          },
          "fiveVoltTolerant": { "type": "boolean", "description": "是否 5V 容忍（FT）" },
          "jtagSwd": { "type": ["string", "null"], "description": "被调试口占用时的信号名，如 JTMS/SWDIO" },
          "notesZh": { "type": "string" },
          "relatedFunctionIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
